NAME=rust
VERSION=1.85.0
REVISION=1
URL=https://static.rust-lang.org/dist/rustc-${VERSION}-src.tar.xz
DEPENDS="gcc openssl curl cmake python"

build() {
    echo "[rust] Downloading stage0 compiler..."
    STAGE0_URL="https://static.rust-lang.org/dist/rustc-1.84.0-x86_64-unknown-linux-gnu.tar.gz"
    curl -fL -o rustc-stage0.tar.gz "${STAGE0_URL}"
    tar -xf rustc-stage0.tar.gz
    cd rustc-1.84.0-x86_64-unknown-linux-gnu
    ./install.sh --prefix=$(pwd)/../stage0

    cd ..
    mkdir -p build && cd build

    ../configure \
        --prefix=/usr \
        --release-channel=stable \
        --build=x86_64-unknown-linux-gnu \
        --host=x86_64-unknown-linux-gnu \
        --target=x86_64-unknown-linux-gnu \
        --rustc=$(pwd)/../stage0/bin/rustc \
        --cargo=$(pwd)/../stage0/bin/cargo

    python3 ../x.py build --stage 1
    cd -
}

upac_install() {
    python3 x.py install
}
