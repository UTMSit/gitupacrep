NAME=gcc
VERSION=15.1.0
REVISION=1
URL=https://ftp.gnu.org/gnu/gcc/gcc-${VERSION}/gcc-${VERSION}.tar.xz
DEPENDS="gmp mpfr mpc isl"

build() {
    mkdir -p build && cd build
    CC=gcc CXX=g++ \
    CFLAGS="-std=gnu17 -O2" CXXFLAGS="-std=gnu++17 -O2" \
    ../configure \
        --prefix=/usr \
        --enable-languages=c,c++ \
        --disable-multilib \
        --disable-bootstrap \
        --with-system-zlib \
        --with-native-system-header-dir=/usr/include
    make -j${UPAC_JOBS:-4}
    cd -
}

upac_install() {
    make -C build install
}
