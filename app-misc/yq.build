NAME="yq"
VERSION="4.54.3"
REVISION=1
URL="https://github.com/mikefarah/yq/archive/refs/tags/v${VERSION}.tar.gz"
DEPENDS="go"

build() {
    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s  ../v4.54.3.tar.gz\n' '93143d49b2a3bd6cb723477f585366b29f70c636af4653191d61b49b0c47de7f' | sha256sum -c - >/dev/null
    fi
    go build -o yq .
}

upac_install() {
    install -D -m 755 yq "${1}/usr/bin/yq"
    install -D -m 644 LICENSE "${1}/usr/share/licenses/yq/LICENSE"
}
