NAME="jq"
VERSION="1.8.2"
REVISION=1
URL="https://github.com/jqlang/jq/releases/download/jq-${VERSION}/jq-${VERSION}.tar.gz"
DEPENDS=""

build() {
    # jq ships oniguruma in vendor/, so no external regex dependency is needed.
    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s  ../jq-1.8.2.tar.gz\n' '71b8d6e8f5fe81f6c6d0d110e3892251f6ce76ed095abd315e26e6e1193af3af' | sha256sum -c - >/dev/null
    fi
    ./configure --prefix=/usr --with-oniguruma=builtin --disable-maintainer-mode
    make -j${UPAC_JOBS:-4}
}

upac_install() {
    make DESTDIR="${1}" install
}
