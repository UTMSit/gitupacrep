NAME="fd"
VERSION="10.2.0"
REVISION=1
URL="https://github.com/sharkdp/fd/archive/refs/tags/v${VERSION}.tar.gz"
DEPENDS="rust"

build() {
    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s  ../v10.2.0.tar.gz\n' '73329fe24c53f0ca47cd0939256ca5c4644742cb7c14cf4114c8c9871336d342' | sha256sum -c - >/dev/null
    fi
    cargo build --release --locked
}

upac_install() {
    install -D -m 755 target/release/fd "${1}/usr/bin/fd"
    install -D -m 644 doc/fd.1 "${1}/usr/share/man/man1/fd.1"
    install -D -m 644 LICENSE-MIT "${1}/usr/share/licenses/fd/LICENSE-MIT"
    install -D -m 644 LICENSE-APACHE "${1}/usr/share/licenses/fd/LICENSE-APACHE"
}
