NAME=fastfetch
VERSION=latest
REVISION=1
URL=https://github.com/fastfetch-cli/fastfetch/archive/refs/heads/dev.zip
DEPENDS="libpci vulkan-loader wayland libX11 libXrandr dconf chafa libdrm"

build() {
    mkdir -p build && cd build
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTS=OFF \
        -DENABLE_SYSTEM_INFO=ON \
        -DENABLE_GPU=ON \
        -DENABLE_AUDIO=OFF \
        -DENABLE_BATTERY=ON \
        -DENABLE_BLUETOOTH=ON \
        -DENABLE_CAMERA=OFF \
        -DENABLE_DMI=ON \
        -DENABLE_OPENGL=ON \
        -DENABLE_VULKAN=ON \
        -DENABLE_WAYLAND=ON \
        -DENABLE_X11=ON \
        -DENABLE_XCB=ON \
        -DENABLE_XRANDR=ON \
        -DENABLE_DRM=ON \
        -DENABLE_CHAFA=ON \
        -DENABLE_DCONF=ON \
        -DENABLE_PCI=ON
    make -j${UPAC_JOBS:-4}
}

upac_install() {
    cd build
    make DESTDIR=/ install
    # Создать конфигурацию по умолчанию
    if [ ! -d /etc/fastfetch ]; then
        mkdir -p /etc/fastfetch
    fi
    cp ../presets/* /etc/fastfetch/ 2>/dev/null || true
}
