NAME="micro"
VERSION="2.0.15"
REVISION=1
URL="https://github.com/zyedidia/micro/archive/refs/tags/v${VERSION}.tar.gz"
DEPENDS="go"

build() {
    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s  ../v2.0.15.tar.gz\n' '612c775321c268c8f9e1767505ff378bca9b9ab66f5c41b69ecb2464ecf15084' | sha256sum -c - >/dev/null
    fi
    go build -trimpath \
        -ldflags "-s -w -X github.com/zyedidia/micro/v2/internal/util.Version=2.0.15" \
        -o micro ./cmd/micro
}

upac_install() {
    install -D -m 755 micro "${1}/usr/bin/micro"
    install -D -m 644 LICENSE "${1}/usr/share/licenses/micro/LICENSE"
    install -D -m 644 LICENSE-THIRD-PARTY "${1}/usr/share/licenses/micro/LICENSE-THIRD-PARTY"
}
