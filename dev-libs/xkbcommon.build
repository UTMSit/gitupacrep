NAME=xkbcommon
VERSION=latest
REVISION=1
URL=https://github.com/xkbcommon/libxkbcommon/archive/refs/heads/master.tar.gz
DEPENDS="xkeyboard-config"

build() {
    mkdir -p build && cd build
    meson setup .. \
        --prefix=/usr \
        -Dx11=disabled \
        -Dcompose=disabled \
        -Dcairo=disabled \
        -Dtest=false \
        -Ddoc=false
    ninja
}

upac_install() {
    cd build
    DESTDIR="${1}" ninja install
}
