NAME="fribidi"
VERSION="1.0.16"
REVISION=1
URL="https://github.com/fribidi/fribidi/releases/download/v${VERSION}/fribidi-${VERSION}.tar.xz"
DEPENDS=""

build() {
    meson setup build --prefix=/usr -Ddocs=false
    ninja -C build -j${UPAC_JOBS:-4}
}

upac_install() {
    DESTDIR="${1}" ninja -C build install
}
