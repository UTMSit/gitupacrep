NAME="libevent"
VERSION="2.1.12"
REVISION=1
URL="https://github.com/libevent/libevent/releases/download/release-${VERSION}-stable/libevent-${VERSION}-stable.tar.gz"
DEPENDS=""

build() {
    ./configure --prefix=/usr --disable-static
    make -j${UPAC_JOBS:-4}
}

upac_install() {
    make DESTDIR="${1}" install
}
