NAME="libnftnl"
VERSION="1.3.1"
REVISION=1
URL="https://netfilter.org/projects/libnftnl/files/libnftnl-${VERSION}.tar.xz"
DEPENDS="libmnl"

build() {
    DEPS=/usr
    if [ -d /tmp/upac-staging-0/libmnl-1.0.5/usr ]; then
        DEPS="$PWD/.upac-deps"
        mkdir -p "$DEPS/lib/pkgconfig" "$DEPS/include"
        cp -a /tmp/upac-staging-0/libmnl-1.0.5/usr/. "$DEPS"/
        sed -i \
            -e "s|^prefix=/usr|prefix=$DEPS|" \
            -e "s|^libdir=/usr/lib|libdir=$DEPS/lib|" \
            "$DEPS"/lib/pkgconfig/*.pc
        sed -i "s|libdir='/usr/lib'|libdir='$DEPS/lib'|" "$DEPS"/lib/*.la
        export PKG_CONFIG_PATH="$DEPS/lib/pkgconfig"
        export CPPFLAGS="-I$DEPS/include"
        export LDFLAGS="-L$DEPS/lib -Wl,-rpath,/usr/lib"
    fi
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static
    make -j${UPAC_JOBS:-4}
}

upac_install() {
    make DESTDIR="${1}" install
}
