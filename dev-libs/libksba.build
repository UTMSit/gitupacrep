NAME="libksba"
VERSION="1.9.1"
REVISION=1
URL="https://gnupg.org/ftp/gcrypt/libksba/libksba-${VERSION}.tar.bz2"
DEPENDS="libgpg-error"

build() {
    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s  ../libksba-1.9.1.tar.bz2\n' '9afdd398b4a076735e1e7fd29c7f6e7670b6c382aee2d3a55aa937b283f43e5b' | sha256sum -c - >/dev/null
    fi
    ./configure --prefix=/usr --libdir=/usr/lib --with-libgpg-error-prefix=/usr --disable-static
    make -j${UPAC_JOBS:-4}
}

upac_install() {
    make DESTDIR="${1}" install
}
