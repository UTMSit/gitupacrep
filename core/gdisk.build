NAME=gdisk
VERSION=1.0.10
REVISION=1
URL=https://downloads.sourceforge.net/project/gptfdisk/gptfdisk/${VERSION}/gptfdisk-${VERSION}.tar.gz
DEPENDS="popt"

build() {
    make -j${UPAC_JOBS:-4}
}

upac_install() {
    mkdir -p "${1}/usr/bin" "${1}/usr/share/man/man8"
    install -m 755 gdisk sgdisk cgdisk fixparts "${1}/usr/bin/"
    install -m 644 gdisk.8 sgdisk.8 cgdisk.8 fixparts.8 "${1}/usr/share/man/man8/"
}
