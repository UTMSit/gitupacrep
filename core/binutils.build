NAME=binutils
VERSION=latest
REVISION=1
URL=https://ftp.gnu.org/gnu/binutils/binutils-${VERSION}.tar.xz
DEPENDS=""

build() {
    mkdir -p build && cd build
    ../configure \
        --prefix=/usr \
        --disable-werror \
        --disable-gprofng \
        --enable-deterministic-archives \
        --enable-64-bit-bfd \
        --with-system-zlib
    make -j${UPAC_JOBS:-4}
}

upac_install() {
    cd build
    make DESTDIR="${1}" install
}
