NAME=e2fsprogs
VERSION=1.47.0
REVISION=1
URL=https://downloads.sourceforge.net/project/e2fsprogs/e2fsprogs/v${VERSION}/e2fsprogs-${VERSION}.tar.gz
DEPENDS=""

build() {
    ./configure --prefix=/usr --with-root-prefix=/usr --enable-elf-shlibs
    make -j${UPAC_JOBS:-4}
}

upac_install() {
    make DESTDIR="${1}" install
    make DESTDIR="${1}" install-libs
}
