NAME=crinit
VERSION=latest
REVISION=1
URL=https://github.com/UTMSit/crinit/archive/refs/heads/main.zip
DEPENDS="umk gcc"

build() {
    umk build -j${UPAC_JOBS:-4}
}

upac_install() {
    mkdir -p "$1/sbin"
    install -m 755 crinit "$1/sbin/init"

    umk clean >/dev/null 2>&1 || true

    mkdir -p "$1/usr/src/CRinit"
    cp -r . "$1/usr/src/CRinit/"
}
