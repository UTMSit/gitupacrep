NAME=sfc
VERSION=latest
REVISION=1
URL=https://github.com/user12msd4c/sfc/archive/refs/heads/main.zip
DEPENDS="rust"

build() {
    cargo build --release
    cd target/release
    ln -sf ls dir
    ln -sf ls vdir
    ln -sf touch mk
    ln -sf id whoami
    cd -
}

upac_install() {
    for bin in target/release/*; do
        name=$(basename "$bin")
        if [ -L "$bin" ]; then
            cp -P "$bin" "/bin/$name"
        elif [ -f "$bin" ] && [ -x "$bin" ]; then
            install -m 755 "$bin" "/bin/$name"
        fi
    done
    ln -sf /bin/sfsh /bin/sh
}
