NAME="shadow"
VERSION="4.13"
REVISION=1
URL="https://github.com/shadow-maint/shadow/releases/download/${VERSION}/shadow-${VERSION}.tar.xz"
DEPENDS=""

build() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --without-pam \
        --disable-shared
    make -j${UPAC_JOBS:-4}
}

upac_install() {
    make DESTDIR="${1}" install
}
