NAME=comrun7-installer
VERSION=1
REVISION=1
URL=https://github.com/UTMSit/gitupacrep/archive/refs/heads/main.zip
# Python 3 and the compiler are already in the LiveCD.  Declaring them here
# would make upac rebuild their dependency chain on the minimal live system.
DEPENDS=""

# The installer is kept in this repository under core/comrun7-installer.  It
# is not part of the LiveCD image; install this package from a booted LiveCD
# and run "comrun7-install" to partition and install comrun7.
#
# GitHub zip archives put the files under gitupacrep-<branch>/.  The loop also
# allows a locally staged copy of this repository to be used.
build() {
    SRC=""
    for d in \
        gitupacrep-main/core/comrun7-installer \
        gitupacrep-master/core/comrun7-installer \
        core/comrun7-installer; do
        if [ -d "$d" ]; then
            SRC="$d"
            break
        fi
    done
    if [ -z "$SRC" ]; then
        SRC=$(find . -maxdepth 4 -type d -name comrun7-installer 2>/dev/null | head -n 1 || true)
    fi
    [ -n "$SRC" ] || {
        echo "[comrun7-installer] cannot find core/comrun7-installer in source" >&2
        exit 1
    }

    cp -a "$SRC"/. .
    sh build.sh
}

upac_install() {
    DEST="${1}/usr/share/comrun7-installer"
    mkdir -p "$DEST" "${1}/usr/bin"

    cp -a README.md build.sh comrun7-install.py install-to-disk.sh \
        comrun7-adduser.sh hashpw.c write_grub_cfg.sh install.conf.example \
        comrun7-hashpw "$DEST/"

    chmod 0755 "$DEST/comrun7-install.py" "$DEST/install-to-disk.sh" \
        "$DEST/comrun7-adduser.sh" "$DEST/write_grub_cfg.sh" \
        "$DEST/comrun7-hashpw" "$DEST/build.sh"

    ln -sf ../share/comrun7-installer/comrun7-install.py \
        "${1}/usr/bin/comrun7-install"
}
