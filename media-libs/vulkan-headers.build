NAME=vulkan-headers
VERSION=latest
REVISION=1
URL=https://github.com/KhronosGroup/Vulkan-Headers/archive/refs/heads/main.zip
DEPENDS=""

build() {
    mkdir -p build && cd build
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    make -j${UPAC_JOBS:-4}
}

upac_install() {
    cd build
    make install
}
