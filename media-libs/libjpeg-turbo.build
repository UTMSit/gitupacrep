NAME=libjpeg-turbo
VERSION=3.0.4
REVISION=1
URL=https://github.com/libjpeg-turbo/libjpeg-turbo/releases/download/3.0.4/libjpeg-turbo-3.0.4.tar.gz
DEPENDS=""

build() {
    ./configure \
        --prefix=/usr \
        --disable-static
    make -j${UPAC_JOBS:-4}
}

upac_install() {
    make DESTDIR="${1}" install
}
