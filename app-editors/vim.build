NAME="vim"
VERSION="9.1.1800"
REVISION=1
URL="https://github.com/vim/vim/archive/v${VERSION}.tar.gz"
DEPENDS="ncurses"

build() {
    ./configure --prefix=/usr --with-features=huge --enable-gui=no \
        --without-x --disable-python3interp --enable-multibyte
    make -j${UPAC_JOBS:-4}
}

upac_install() {
    make DESTDIR="${1}" install
}
