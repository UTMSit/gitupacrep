NAME=pixman
VERSION=latest
REVISION=1
URL=https://gitlab.freedesktop.org/pixman/pixman/-/archive/master/pixman-master.tar.gz
DEPENDS=""

build() {
    mkdir -p build && cd build
    meson setup .. \
        --prefix=/usr \
        -Dtests=disabled \
        -Dgtk=disabled \
        -Dlibpng=disabled
    ninja
}

upac_install() {
    cd build
    DESTDIR="${1}" ninja install
}
