NAME=upac
VERSION=1.0.0
REVISION=1
URL=https://github.com/UTMSit/upac/archive/refs/tags/v${VERSION}.tar.gz
DEPENDS=""

build() {
    umk build -j${UPAC_JOBS:-4}
}

upac_install() {
    mkdir -p "${1}/usr/bin" "${1}/var/lib/upac" "${1}/var/cache/upac" "${1}/etc/upac/local" "${1}/var/lib/upac/files"
    install -m 755 upac "${1}/usr/bin/"
}
