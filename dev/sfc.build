NAME=sfc
VERSION=0.1.0
REVISION=1
URL=https://github.com/user12msd4c/sfc/archive/refs/heads/main.zip
DEPENDS="cargo"

build() {
    cargo build --release
}

upac_install() {
    mkdir -p "${1}/usr/bin"
    
    if [ -d target/release ]; then
        for bin in target/release/*; do
            if [ -f "$bin" ] && [ -x "$bin" ]; then
                install -m 755 "$bin" "${1}/usr/bin/"
            fi
        done
    fi
}
