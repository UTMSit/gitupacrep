NAME="sddm"
VERSION="0.21.0"
REVISION=1
URL="https://github.com/sddm/sddm/releases/download/v${VERSION}/sddm-${VERSION}.tar.xz"
DEPENDS="qt5-base"

build() {
    mkdir build
    cd build
    cmake .. -DCMAKE_INSTALL_PREFIX=/usr
    make -j $UPAC_JOBS
}

upac_install() {
    DESTDIR="$1" make -C build install
}
