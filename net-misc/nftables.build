NAME="nftables"
VERSION="1.1.5"
REVISION=1
URL="https://netfilter.org/projects/nftables/files/nftables-${VERSION}.tar.xz"
DEPENDS="libnftnl libmnl"

build() {
    DEPS=/usr
    if [ -d /tmp/upac-staging-0/libnftnl-1.3.1/usr ]; then
        DEPS="$PWD/.upac-deps"
        mkdir -p "$DEPS/lib/pkgconfig" "$DEPS/include"
        for p in libmnl-1.0.5 libnftnl-1.3.1; do
            s="/tmp/upac-staging-0/${p}/usr"
            [ -d "$s" ] || continue
            cp -a "$s"/. "$DEPS"/
        done
        sed -i \
            -e "s|^prefix=/usr|prefix=$DEPS|" \
            -e "s|^libdir=/usr/lib|libdir=$DEPS/lib|" \
            "$DEPS"/lib/pkgconfig/*.pc
        sed -i \
            -e "s|libdir='/usr/lib'|libdir='$DEPS/lib'|" \
            -e "s|/usr/lib/libmnl.la|$DEPS/lib/libmnl.la|g" \
            "$DEPS"/lib/*.la
        export PKG_CONFIG_PATH="$DEPS/lib/pkgconfig"
        export CPPFLAGS="-I$DEPS/include"
        export LDFLAGS="-L$DEPS/lib -Wl,-rpath,/usr/lib"
    fi
    ./configure --prefix=/usr --with-mini-gmp --without-cli
    make -j${UPAC_JOBS:-4}
}

upac_install() {
    make DESTDIR="${1}" install
}
