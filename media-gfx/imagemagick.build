NAME="imagemagick"
VERSION="7.1.1-29"
REVISION=1
URL="https://github.com/ImageMagick/ImageMagick/archive/refs/tags/${VERSION}.tar.gz"
DEPENDS="libjpeg-turbo libpng libtiff libwebp freetype zlib"

build() {
    ./configure \
        --prefix=/usr \
        --without-x \
        --disable-openmp \
        --with-magick-plus-plus=no
    make -j${UPAC_JOBS:-4}
}

upac_install() {
    make DESTDIR="${1}" install
}
