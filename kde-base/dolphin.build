NAME="dolphin"
VERSION="24.08.0"
REVISION=1
URL="https://download.kde.org/stable/release-service/${VERSION}/src/dolphin-${VERSION}.tar.xz"
DEPENDS="qt6-base kio"

build() {
    cmake -B build -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build -j $UPAC_JOBS
}

upac_install() {
    DESTDIR="$1" cmake --install build
}
