NAME="xz"
VERSION="5.6.2"
REVISION=1
URL="https://github.com/tukaani-project/xz/releases/download/v${VERSION}/xz-${VERSION}.tar.gz"
DEPENDS=""

build() {
    ./configure \
        --prefix=/usr \
        --disable-static
    make -j${UPAC_JOBS:-4}
}

upac_install() {
    make DESTDIR="${1}" install
}
