NAME="lz4"
VERSION="1.11.1"
REVISION=1
URL="https://github.com/lz4/lz4/releases/download/v${VERSION}/lz4-${VERSION}.tar.gz"
DEPENDS=""

build() {
    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s  ../lz4-1.11.1.tar.gz\n' '683fed08a844ad012196381e40badf80c0bbe4962959761416d41c9e67d77ec7' | sha256sum -c - >/dev/null
    fi
    make -j${UPAC_JOBS:-4}
}

upac_install() {
    install -D -m 755 programs/lz4 "${1}/usr/bin/lz4"
    ln -sf lz4 "${1}/usr/bin/unlz4"
    ln -sf lz4 "${1}/usr/bin/lz4cat"
    install -D -m 644 lib/liblz4.so.1.11.1 "${1}/usr/lib/liblz4.so.1.11.1"
    ln -sf liblz4.so.1.11.1 "${1}/usr/lib/liblz4.so.1"
    ln -sf liblz4.so.1.11.1 "${1}/usr/lib/liblz4.so"
    install -D -m 644 lib/liblz4.a "${1}/usr/lib/liblz4.a"
    install -D -m 644 lib/lz4.h "${1}/usr/include/lz4.h"
    install -D -m 644 lib/lz4hc.h "${1}/usr/include/lz4hc.h"
    install -D -m 644 lib/lz4frame.h "${1}/usr/include/lz4frame.h"
    install -D -m 644 lib/liblz4.pc "${1}/usr/lib/pkgconfig/liblz4.pc"
    install -D -m 644 programs/lz4.1 "${1}/usr/share/man/man1/lz4.1"
}
